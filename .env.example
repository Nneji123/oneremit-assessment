# Environment
ENVIRONMENT=local
DEBUG=1

# Django
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (individual vars - settings.py constructs DATABASE_URL from these)
POSTGRES_DB=oneremit
POSTGRES_USER=oneremit
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Provider webhook (required assessment configuration)
PROVIDER_WEBHOOK_SECRET=change-me-in-production

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
